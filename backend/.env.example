# Backend configuration (copy to .env)
PORT=4000

# Path to the Firebase Admin service account JSON (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Optional: https://<project>.firebaseio.com and storage bucket
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Admin bootstrap account (created with npm run seed)
ADMIN_EMAIL=admin@fleet.local
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_PHONE=

# Document expiry warning window in days
EXPIRY_WARNING_DAYS=30
# Max upload size in MB
MAX_FILE_SIZE_MB=5
